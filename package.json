{
  "name": "weight-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Weight – personal local-first gym log (PWA)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/check-bundle.mjs",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "rtm": "python3 scripts/gen_rtm.py",
    "lint": "eslint . && node scripts/check-i18n.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run audit:runtime",
    "audit:runtime": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@mantine/core": "7.17.8",
    "@mantine/hooks": "7.17.8",
    "@mantine/notifications": "7.17.8",
    "@tabler/icons-react": "3.52.0",
    "dexie": "4.4.7",
    "dexie-react-hooks": "1.1.7",
    "jszip": "3.10.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.18.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.1",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.65.1",
    "@types/node": "22.20.5",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "fake-indexeddb": "6.2.8",
    "globals": "15.15.0",
    "postcss": "8.5.33",
    "postcss-preset-mantine": "1.18.0",
    "postcss-simple-vars": "7.0.1",
    "typescript": "5.7.3",
    "typescript-eslint": "8.74.0",
    "vite": "6.4.6",
    "vite-plugin-pwa": "0.21.2",
    "vitest": "5.1.2",
    "workbox-window": "7.4.1"
  },
  "overrides": {
    "workbox-build": {
      "glob": "14.0.6"
    }
  }
}
